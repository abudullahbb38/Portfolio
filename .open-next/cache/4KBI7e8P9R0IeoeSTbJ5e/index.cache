{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"__variable_0d7163 __variable_0a80b4 h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7b6453307a6c50fd.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-828257078d20104c.js\"/><script src=\"/_next/static/chunks/4bd1b696-92152b0f5947070d.js\" async=\"\"></script><script src=\"/_next/static/chunks/794-d1a40dcf24d651d9.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-aec9d1ec2c72797f.js\" async=\"\"></script><script src=\"/_next/static/chunks/538-5ca517ade481b373.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-1db470259928fb80.js\" async=\"\"></script><title>Abudullahbb|Full stack developer</title><meta name=\"description\" content=\"Independent product designer and developer crafting thoughtful digital tools.\"/><link rel=\"icon\" href=\"/favicon.ico?603d046c9a6fdfbb\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"site-shell\"><header class=\"nav\" style=\"opacity:0;transform:translateY(-16px)\"><a class=\"nav-email\" href=\"mailto:abudullahbb38@gmail.com\">abudullahbb38@gmail.com</a><a class=\"logo\" href=\"#top\">ME<span>.</span></a><nav><a href=\"#work\">Work</a><a href=\"#skills\">Skills</a><a href=\"#experience\">Experience</a><a href=\"#contact\">Contact</a></nav></header><main id=\"top\"><section class=\"hero\" style=\"opacity:0;transform:translateY(28px)\"><div class=\"hero-copy\"><p class=\"eyebrow\">ABOUT ME</p><p class=\"hero-name\">Abudullah Basil Bilal</p></div><div class=\"hero-about\"><div class=\"hero-description-row\"><p class=\"hero-about-tag\">Independent designer + developer</p><p class=\"hero-description\">I have over 5 years of experience building frontend, backend, and full-stack applications. I have developed many websites and digital products, turning thoughtful ideas into fast, reliable experiences.</p></div><a class=\"hero-cta\" href=\"#about\">More about me <span>↓</span></a></div></section><section class=\"section-block work\" id=\"work\" style=\"opacity:0;transform:translateY(28px)\"><div class=\"section-heading\"><div><p class=\"eyebrow\">01 / Selected work</p></div></div><div class=\"projects\"><article class=\"project-card project-card-featured\"><div class=\"project-image\" role=\"img\" aria-label=\"Payme project preview\" style=\"background-image:url(/payme-preview.png)\"><span class=\"project-image-kicker\">Live product / Payme</span></div><div class=\"project-card-top\"><span class=\"project-index\">0<!-- -->1</span><span class=\"project-stage\">Frontend site</span><span class=\"status-shipped\">Shipped</span></div><div class=\"project-meta\"><div><p class=\"project-type\">Payment service<!-- --> / <!-- -->2023</p><h3>Payme</h3><p>A clear, trustworthy payment experience that makes everyday money movement feel effortless.</p><p class=\"project-details\">Developed the responsive Payme site experience for payments, mobile top-ups, service discovery, and account access, with a focus on clarity and conversion.</p></div><div class=\"skill-tags\"><span>React</span><span>TypeScript</span><span>Responsive UI</span><span>UX systems</span></div></div><div class=\"project-links\"><a href=\"https://payme.uz/\" target=\"_blank\" rel=\"noreferrer\">Visit site ↗</a></div></article><article class=\"project-card\"><div class=\"project-image\" role=\"img\" aria-label=\"Clutch project preview\" style=\"background-image:url(/clutch-preview.png)\"></div><div class=\"project-card-top\"><span class=\"project-index\">0<!-- -->2</span><span class=\"project-stage\">Backend servers</span><span class=\"status-shipped\">Shipped</span></div><div class=\"project-meta\"><div><p class=\"project-type\">B2B marketplace<!-- --> / <!-- -->2023</p><h3>Clutch</h3><p>A confident discovery platform that helps businesses find the right agency with less guesswork.</p><p class=\"project-details\">Developed the Clutch site experience around company profiles, trusted reviews, service categories, and search, making complex decisions easier for growing teams.</p></div><div class=\"skill-tags\"><span>Node.js</span><span>REST API</span><span>Search</span><span>Content systems</span></div></div><div class=\"project-links\"><a href=\"https://clutch.co/\" target=\"_blank\" rel=\"noreferrer\">Visit site ↗</a></div></article></div></section><section class=\"section-block skills\" id=\"skills\" style=\"opacity:0;transform:translateY(28px)\"><div class=\"section-heading\"><div><p class=\"eyebrow\">02 / THE SKILLS</p></div></div><div class=\"skills-grid\"><div class=\"skill-group\"><p class=\"skill-number\">0<!-- -->1</p><h3>Front-end</h3><ul><li>Next.js</li><li>React</li><li>Tailwind CSS</li><li>Framer Motion</li></ul></div><div class=\"skill-group\"><p class=\"skill-number\">0<!-- -->2</p><h3>Back-end</h3><ul><li>Node.js</li><li>Prisma</li><li>REST APIs</li><li>SQLite / PostgreSQL</li></ul></div><div class=\"skill-group\"><p class=\"skill-number\">0<!-- -->3</p><h3>DevOps &amp; tools</h3><ul><li>GitHub Actions</li><li>Vercel</li><li>Docker</li><li>Figma</li></ul></div></div></section><section class=\"section-block experience\" id=\"experience\" style=\"opacity:0;transform:translateY(28px)\"><div class=\"section-heading\"><div><p class=\"eyebrow\">03 / Experience</p></div></div><div class=\"experience-list\"><article class=\"experience-row\"><p class=\"experience-period\">Jul 2021 — Mar 2024</p><div><h3>Frontend Developer</h3><p class=\"experience-place\">SUP</p><p class=\"experience-copy\">Built responsive interfaces, reusable components, and polished user experiences that made products clear and easy to use.</p></div><span class=\"row-arrow\">↗</span></article><article class=\"experience-row\"><p class=\"experience-period\">Apr 2024 — May 2025</p><div><h3>Backend Developer</h3><p class=\"experience-place\">SUP</p><p class=\"experience-copy\">Developed APIs, databases, authentication, and reliable server-side systems that powered the product experience behind the interface.</p></div><span class=\"row-arrow\">↗</span></article><article class=\"experience-row\"><p class=\"experience-period\">Jun 2025 — now</p><div><h3>Full-stack Developer / Software Engineer</h3><p class=\"experience-place\">Current role</p><p class=\"experience-copy\">Bring frontend and backend together to develop complete, maintainable products from the first idea through production.</p></div><span class=\"row-arrow\">↗</span></article></div></section><section class=\"contact\" id=\"contact\" style=\"opacity:0;transform:translateY(28px)\"><div><p class=\"eyebrow\">05 / Start a conversation</p><h2>Have a good<br/><em>one?</em> Let&#x27;s talk.</h2><p class=\"contact-intro\">Have a project, a question, or a good book recommendation? I&#x27;d love to hear from you.</p></div><form class=\"contact-form\"><label>Name<input required=\"\" placeholder=\"Your name\" name=\"name\"/></label><label>Email<input required=\"\" type=\"email\" placeholder=\"you@company.com\" name=\"email\"/></label><label>Message<textarea required=\"\" name=\"message\" rows=\"4\" placeholder=\"Tell me what you&#x27;re building...\"></textarea></label><button type=\"submit\">Send message<span aria-hidden=\"true\">↗</span></button></form></section></main><footer><span>© 2025 Mara Ellis</span><span>Made with care &amp; curiosity</span><a href=\"#top\">Back to top ↑</a></footer></div><!--$--><!--/$--><sc